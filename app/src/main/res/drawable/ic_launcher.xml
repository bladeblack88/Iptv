<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="315"
                android:startColor="#E000D8"
                android:centerColor="#6500D8"
                android:endColor="#10005C"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_launcher_mark"
        android:gravity="center"
        android:width="42dp"
        android:height="42dp" />
</layer-list>