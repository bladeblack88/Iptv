<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="315"
                android:startColor="#B69AFF"
                android:endColor="#6945D6"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_launcher_mark"
        android:gravity="center"
        android:width="30dp"
        android:height="30dp" />
</layer-list>